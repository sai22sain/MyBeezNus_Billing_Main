SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
PORT=3001
# Optional: shared secret that protects the dashboard when hosted publicly.
# Leave unset for local use (no token prompt).
# ADMIN_TOKEN=some-long-random-string
# Optional: absolute path to the legacy SQLite DB (only used by the Wipe button)
# BACKEND_BASE_SQLITE_DB=c:/salon-app/backend/salon.db